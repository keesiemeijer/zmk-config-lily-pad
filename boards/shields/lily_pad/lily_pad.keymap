#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        encoder_volume: encoder_volume {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp N1     &kp N2      &kp N3
                &kp N4     &kp N5      &kp N6
                &kp N7     &kp N8      &kp N9
                &kp N1     &kp N2      &kp N3
            >;
            sensor-bindings = <&encoder_volume>;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
                &kp F1      &kp F2      &kp F3
                &kp F4      &kp F5      &kp F6
                &kp C_PREV  &kp C_PP    &kp C_NEXT
                &kp K_MUTE  &trans      &kp BSPC
            >;
            sensor-bindings = <&encoder_volume>;
        };
    };
};